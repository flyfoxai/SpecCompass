{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speccompass.dev/schemas/outline-transition-staging-plan.schema.json",
  "title": "SpecCompass Outline Transition Staging Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transition_id", "inventory_digest", "staging_root", "operations"],
  "properties": {
    "schema_version": {"const": 1},
    "transition_id": {"type": "string", "minLength": 1},
    "inventory_digest": {"$ref": "outline-boundaries.schema.json#/$defs/digest"},
    "staging_root": {"$ref": "outline-boundaries.schema.json#/$defs/repoRef"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/operation"}
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type", "source_artifact_ref", "operation", "target_artifact_ref",
        "target_feature_code", "staged_artifact_ref"
      ],
      "properties": {
        "artifact_type": {
          "enum": ["prd", "outline", "spec", "flow", "ui", "plan", "tasks", "implementation", "test", "trace", "memory", "open_item"]
        },
        "source_artifact_ref": {"$ref": "outline-boundaries.schema.json#/$defs/repoRef"},
        "operation": {"enum": ["move", "copy", "rewrite", "retire"]},
        "target_artifact_ref": {
          "oneOf": [{"type": "null"}, {"$ref": "outline-boundaries.schema.json#/$defs/repoRef"}]
        },
        "target_feature_code": {
          "oneOf": [{"type": "null"}, {"$ref": "outline-boundaries.schema.json#/$defs/featureCode"}]
        },
        "staged_artifact_ref": {
          "oneOf": [{"type": "null"}, {"$ref": "outline-boundaries.schema.json#/$defs/repoRef"}]
        }
      }
    }
  }
}
