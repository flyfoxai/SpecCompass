{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speccompass.dev/schemas/outline-transition-publication.schema.json",
  "title": "SpecCompass Outline Transition Publication Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "transition_id", "proposal_digest", "inventory_digest",
    "manifest_digest", "phase", "updated_at", "completed_operations", "receipt_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "transition_id": {"type": "string", "minLength": 1},
    "proposal_digest": {"$ref": "outline-boundaries.schema.json#/$defs/digest"},
    "inventory_digest": {"$ref": "outline-boundaries.schema.json#/$defs/digest"},
    "manifest_digest": {"$ref": "outline-boundaries.schema.json#/$defs/digest"},
    "phase": {"enum": ["STAGED", "ARTIFACTS_PUBLISHED", "BASELINE_COMMITTED"]},
    "updated_at": {"type": "string", "format": "date-time"},
    "completed_operations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^op-[0-9]{4}$"}
    },
    "receipt_digest": {"$ref": "outline-boundaries.schema.json#/$defs/digest"}
  }
}
