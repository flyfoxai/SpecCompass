{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speccompass.local/schemas/outline-discovery-data.schema.json",
  "title": "SpecCompass Outline Discovery Data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "review_type", "interaction_mode", "artifact_path",
    "outline_maturity", "batch_id", "project", "decomposition_window", "source_snapshot", "source_inventory",
    "business_context", "constitution_snapshot",
    "density_budget", "maps", "outline_nodes", "question_groups",
    "authorization_effect", "next_route"
  ],
  "properties": {
    "schema_version": {"const": 6},
    "review_type": {"const": "outline_discovery"},
    "interaction_mode": {"const": "discovery"},
    "artifact_path": {"type": "string", "pattern": "^specs/[^/]+/prd/review/outline-discovery-data\\.json$"},
    "outline_maturity": {"enum": ["explore", "frame"]},
    "batch_id": {"type": "string", "minLength": 1},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "feature", "current_understanding", "discovery_goal"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "feature": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "current_understanding": {"type": "string", "minLength": 1},
        "discovery_goal": {"type": "string", "minLength": 1}
      }
    },
    "decomposition_window": {
      "$ref": "#/$defs/decomposition_window"
    },
    "source_snapshot": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "source_inventory": {
      "$ref": "#/$defs/source_inventory"
    },
    "business_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_subject", "responsibility_owners", "business_lifecycles", "business_states",
        "business_objects", "operations", "outcomes",
        "source_capability_coverage", "capability_atoms", "business_chains", "evidence_gaps"
      ],
      "properties": {
        "product_subject": {"$ref": "#/$defs/sourced_semantic"},
        "responsibility_owners": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/responsibility_owner"}
        },
        "business_lifecycles": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/business_lifecycle"}
        },
        "business_states": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/business_state"}
        },
        "business_objects": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/business_object"}
        },
        "operations": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/business_operation"}
        },
        "outcomes": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/business_outcome"}
        },
        "source_capability_coverage": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source_capability_entry"}
        },
        "capability_atoms": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/capability_atom"}
        },
        "business_chains": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/business_chain"}
        },
        "evidence_gaps": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence_gap"}
        }
      }
    },
    "constitution_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "availability", "display_mode", "application_scope", "clauses"],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:/)(?!\\.\\.?(?:/|$))(?!.*\\/\\.\\.?(?:/|$))(?!.*//)[^/]+(?:/[^/]+)*$"
        },
        "availability": {"enum": ["available", "missing"]},
        "display_mode": {"const": "read_only"},
        "application_scope": {"const": "governance_only"},
        "clauses": {
          "type": "array",
          "items": {"$ref": "#/$defs/constitution_clause"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"availability": {"const": "missing"}}},
          "then": {"properties": {"clauses": {"maxItems": 0}}}
        }
      ]
    },
    "density_budget": {
      "type": "object",
      "description": "Fixed child-map presentation budget. Runtime validators exempt the single Overview from node and layer-balance limits so every Level 1 candidate remains directly visible; the Overview has a separate 64-node safety ceiling.",
      "additionalProperties": false,
      "required": [
        "max_visible_nodes_per_map", "max_depth",
        "layer_balance_min_nodes", "max_layer_share"
      ],
      "properties": {
        "max_visible_nodes_per_map": {"const": 18},
        "max_depth": {"const": 3},
        "layer_balance_min_nodes": {"const": 8},
        "max_layer_share": {"const": 0.6}
      }
    },
    "maps": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/map"}
    },
    "outline_nodes": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/outline_node"}
    },
    "question_groups": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/question_group"}
    },
    "authorization_effect": {"const": "none"},
    "next_route": {"const": "/sp.prd"}
  },
  "$defs": {
    "decomposition_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expansion_root_node_id", "root_project_feature", "root_project_depth",
        "generation_mode", "generated_depth", "depth_decision_reason", "parent_path",
        "units", "frontier_unit_ids", "terminal_unit_ids"
      ],
      "properties": {
        "expansion_root_node_id": {"type": "string", "minLength": 1},
        "root_project_feature": {"type": "string", "minLength": 1},
        "root_project_depth": {"type": "integer", "minimum": 0},
        "generation_mode": {"enum": ["decompose", "detail"]},
        "generated_depth": {"type": "integer", "minimum": 0, "maximum": 3},
        "depth_decision_reason": {"type": "string", "minLength": 20},
        "parent_path": {
          "type": "array",
          "items": {"$ref": "#/$defs/outline_path_entry"}
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/outline_unit"}
        },
        "frontier_unit_ids": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "terminal_unit_ids": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "outline_path_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "label", "project_depth"],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "project_depth": {"type": "integer", "minimum": 0}
      }
    },
    "outline_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id", "outline_node_id", "parent_unit_id", "project_depth",
        "decomposition_state", "business_goal", "overall_outcome",
        "capability_atom_refs", "business_chain_refs", "source_status", "source_refs",
        "project_boundary"
      ],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1},
        "outline_node_id": {"type": "string", "minLength": 1},
        "parent_unit_id": {"type": ["string", "null"]},
        "project_depth": {"type": "integer", "minimum": 0},
        "decomposition_state": {"enum": ["expanded", "frontier", "terminal"]},
        "business_goal": {"type": "string", "minLength": 20},
        "overall_outcome": {"type": "string", "minLength": 20},
        "capability_atom_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "business_chain_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_status": {"enum": ["user", "user-confirmed", "doc", "ai-proposed", "unresolved"]},
        "source_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "project_boundary": {"$ref": "#/$defs/project_boundary"},
        "grouping_basis": {"$ref": "#/$defs/grouping_basis"},
        "decomposition_basis": {"$ref": "#/$defs/decomposition_basis"},
        "terminal_basis": {"$ref": "#/$defs/terminal_basis"}
      },
      "allOf": [
        {
          "if": {"properties": {"decomposition_state": {"const": "expanded"}}},
          "then": {"required": ["decomposition_basis"]}
        },
        {
          "if": {"properties": {"decomposition_state": {"const": "terminal"}}},
          "then": {"required": ["terminal_basis"]}
        },
        {
          "if": {"properties": {"capability_atom_refs": {"minItems": 2}}},
          "then": {"required": ["grouping_basis"]}
        },
        {
          "if": {
            "required": ["parent_unit_id", "capability_atom_refs"],
            "properties": {
              "parent_unit_id": {"type": "string"},
              "capability_atom_refs": {"minItems": 2}
            }
          },
          "then": {
            "properties": {
              "grouping_basis": {
                "properties": {
                  "authority": {"enum": ["user", "user-confirmed", "doc", "ai-proposed"]}
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["parent_unit_id", "capability_atom_refs"],
            "properties": {
              "parent_unit_id": {"type": "string"},
              "capability_atom_refs": {"minItems": 2}
            }
          },
          "then": {
            "properties": {
              "grouping_basis": {
                "required": ["coupling_invariants"],
                "properties": {
                  "coupling_invariants": {"minItems": 1}
                }
              }
            }
          }
        }
      ]
    },
    "project_boundary": {
      "type": "object",
      "additionalProperties": false,
      "description": "The business-project contract for this Outline unit. It is required even when the unit is expanded or still a frontier; grouping_basis only explains an atom allocation and cannot replace this contract.",
      "required": [
        "owned_responsibility", "scope", "owned_object_refs", "non_goals",
        "upstream_contracts", "downstream_contracts", "independent_acceptance",
        "unresolved_boundary"
      ],
      "properties": {
        "owned_responsibility": {"type": "string", "minLength": 20},
        "scope": {"type": "string", "minLength": 20},
        "owned_object_refs": {
          "description": "Exactly the business-object set used by this unit's capability atoms; a boundary may not claim unrelated objects.",
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "non_goals": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 12}
        },
        "upstream_contracts": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/project_boundary_contract"}
        },
        "downstream_contracts": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/project_boundary_contract"}
        },
        "independent_acceptance": {"type": "string", "minLength": 20},
        "unresolved_boundary": {"type": "string", "minLength": 12}
      }
    },
    "project_boundary_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id", "counterparty", "business_fact",
        "counterparty_responsibility", "business_chain_refs", "source_refs"
      ],
      "properties": {
        "contract_id": {"type": "string", "minLength": 1},
        "counterparty": {"type": "string", "minLength": 4},
        "business_fact": {"type": "string", "minLength": 12},
        "counterparty_responsibility": {"type": "string", "minLength": 12},
        "business_chain_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "grouping_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority", "shared_business_goal", "shared_responsibility_owner_ref",
        "shared_lifecycle_ref", "parent_cohesion", "separation_test", "source_refs"
      ],
      "properties": {
        "authority": {"enum": ["user", "user-confirmed", "doc", "ai-proposed", "unresolved"]},
        "proposal_origin": {
          "description": "Required by runtime validation when a generated child uses a fresh ai-proposed grouping, owner, or lifecycle.",
          "enum": ["current-discovery"]
        },
        "shared_business_goal": {"type": "string", "minLength": 20},
        "shared_responsibility_owner_ref": {"type": ["string", "null"]},
        "shared_lifecycle_ref": {"type": ["string", "null"]},
        "parent_cohesion": {"type": "string", "minLength": 20},
        "coupling_invariants": {
          "description": "Required by runtime validation for every newly generated grouped child. The expansion root may omit it because a root is the complete source context rather than a newly proposed merge.",
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/coupling_invariant"}
        },
        "separation_test": {"$ref": "#/$defs/separation_test"},
        "source_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "coupling_invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invariant_id", "invariant_kind", "business_rule", "capability_atom_refs",
        "source_status", "evidence_ref", "evidence_quote", "source_refs"
      ],
      "properties": {
        "invariant_id": {"type": "string", "minLength": 1},
        "invariant_kind": {"enum": ["atomic_acceptance", "single_writer_transaction", "regulated_joint_control", "inseparable_lifecycle", "cohesive_data_lifecycle"]},
        "business_rule": {"type": "string", "minLength": 20},
        "capability_atom_refs": {
          "type": "array", "minItems": 2, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_status": {"enum": ["user", "user-confirmed", "doc"]},
        "evidence_ref": {"type": "string", "minLength": 1},
        "evidence_quote": {"type": "string", "minLength": 8},
        "source_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "separation_test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alternative_groups", "stable_handoffs", "duplicated_state_refs",
        "keep_together_complexity", "split_coordination_cost", "decision_reason"
      ],
      "properties": {
        "alternative_groups": {
          "type": "array", "minItems": 2,
          "items": {"$ref": "#/$defs/separation_group"}
        },
        "stable_handoffs": {
          "type": "array",
          "items": {"$ref": "#/$defs/separation_handoff"}
        },
        "duplicated_state_refs": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "keep_together_complexity": {"type": "string", "minLength": 20},
        "split_coordination_cost": {"type": "string", "minLength": 20},
        "decision_reason": {"type": "string", "minLength": 20}
      }
    },
    "separation_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_id", "business_responsibility", "capability_atom_refs"],
      "properties": {
        "group_id": {"type": "string", "minLength": 1},
        "business_responsibility": {"type": "string", "minLength": 20},
        "capability_atom_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "separation_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_group_id", "to_group_id", "from_atom_ref", "to_atom_ref", "business_fact", "source_status", "source_refs"],
      "properties": {
        "from_group_id": {"type": "string", "minLength": 1},
        "to_group_id": {"type": "string", "minLength": 1},
        "from_atom_ref": {"type": "string", "minLength": 1},
        "to_atom_ref": {"type": "string", "minLength": 1},
        "business_fact": {"type": "string", "minLength": 12},
        "source_status": {"enum": ["user", "user-confirmed", "doc", "ai-proposed", "unresolved"]},
        "source_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "decomposition_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complexity_reduction", "child_boundary_summary", "coordination_cost", "source_status", "source_refs"],
      "properties": {
        "complexity_reduction": {"type": "string", "minLength": 20},
        "child_boundary_summary": {"type": "string", "minLength": 20},
        "coordination_cost": {"type": "string", "minLength": 20},
        "source_status": {"enum": ["user", "user-confirmed", "doc", "ai-proposed", "unresolved"]},
        "source_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "terminal_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["indivisible_business_goal", "split_complexity_cost", "manageable_implementation_scope", "source_status", "source_refs"],
      "properties": {
        "indivisible_business_goal": {"type": "string", "minLength": 20},
        "split_complexity_cost": {"type": "string", "minLength": 20},
        "manageable_implementation_scope": {"type": "string", "minLength": 20},
        "source_status": {"enum": ["user", "user-confirmed", "doc", "ai-proposed", "unresolved"]},
        "source_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["map_id", "title", "summary", "map_kind", "root_node_id", "parent_map_id"],
      "properties": {
        "map_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "map_kind": {"enum": ["overview", "branch", "global_constraints", "value_stream"]},
        "root_node_id": {"type": "string", "minLength": 1},
        "parent_map_id": {"type": ["string", "null"]}
      }
    },
    "outline_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id", "parent_node_id", "map_id", "node_kind", "label", "summary", "source_status"
      ],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "parent_node_id": {"type": ["string", "null"]},
        "map_id": {"type": "string", "minLength": 1},
        "node_kind": {
          "enum": [
            "root", "goal", "role", "domain", "scope", "problem", "scenario",
            "capability", "acceptance", "risk", "constraint", "map_link"
          ]
        },
        "label": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "source_status": {"enum": ["user", "user-confirmed", "doc", "ai-proposed", "unresolved"]},
        "source_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "child_map_id": {"type": "string", "minLength": 1},
        "affected_node_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "business_chain_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "capability_atom_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "constitution_clause_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "source_fields": {
      "type": "object",
      "required": ["source_status", "source_refs"],
      "properties": {
        "source_status": {"enum": ["user", "user-confirmed", "doc", "ai-proposed", "unresolved"]},
        "source_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "sourced_semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "summary", "source_status", "source_refs"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "source_status": {"enum": ["user", "user-confirmed", "doc", "ai-proposed", "unresolved"]},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "responsibility_owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_id", "label", "accountability", "source_status", "source_refs"],
      "properties": {
        "owner_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 2},
        "accountability": {"type": "string", "minLength": 12},
        "source_status": {"enum": ["user", "user-confirmed", "doc", "ai-proposed", "unresolved"]},
        "evidence_ref": {"type": "string", "minLength": 1},
        "evidence_quote": {"type": "string", "minLength": 8},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "business_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle_id", "label", "trigger_or_input", "completion_condition", "source_status", "source_refs"],
      "properties": {
        "lifecycle_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 4},
        "trigger_or_input": {"type": "string", "minLength": 8},
        "completion_condition": {"type": "string", "minLength": 12},
        "source_status": {"enum": ["user", "user-confirmed", "doc", "ai-proposed", "unresolved"]},
        "evidence_ref": {"type": "string", "minLength": 1},
        "evidence_quote": {"type": "string", "minLength": 8},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "business_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id", "label", "responsibility_owner_ref", "lifecycle_ref",
        "acceptance_outcome_ref", "source_status", "source_refs"
      ],
      "properties": {
        "state_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 4},
        "responsibility_owner_ref": {"type": "string", "minLength": 1},
        "lifecycle_ref": {"type": "string", "minLength": 1},
        "acceptance_outcome_ref": {"type": "string", "minLength": 1},
        "source_status": {"enum": ["user", "user-confirmed", "doc", "ai-proposed", "unresolved"]},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "business_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "label", "summary", "source_status", "source_refs"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "source_status": {"enum": ["user", "user-confirmed", "doc", "ai-proposed", "unresolved"]},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "business_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "label", "summary", "object_refs", "source_status", "source_refs"],
      "properties": {
        "operation_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "object_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_status": {"enum": ["user", "user-confirmed", "doc", "ai-proposed", "unresolved"]},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "business_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome_id", "label", "summary", "source_status", "source_refs"],
      "properties": {
        "outcome_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "source_status": {"enum": ["user", "user-confirmed", "doc", "ai-proposed", "unresolved"]},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "capability_atom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atom_id", "label", "trigger_kind", "trigger_or_input", "owned_state",
        "owned_state_refs", "object_refs", "operation_refs", "outcome_refs", "primary_outcome_ref",
        "downstream_handoff", "business_chain_refs", "source_status", "source_refs"
      ],
      "properties": {
        "atom_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "trigger_kind": {"enum": ["business_event", "exception_or_interruption", "governance_change"]},
        "trigger_or_input": {"type": "string", "minLength": 1},
        "owned_state": {"type": "string", "minLength": 1},
        "owned_state_refs": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "object_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "operation_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "outcome_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "primary_outcome_ref": {"type": "string", "minLength": 1},
        "downstream_handoff": {"type": "string", "minLength": 1},
        "business_chain_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_status": {"enum": ["user", "user-confirmed", "doc", "ai-proposed", "unresolved"]},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "business_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id", "label", "chain_kind", "trigger_kind", "trigger_or_input", "owned_state",
        "owned_state_refs", "object_refs", "operation_refs", "outcome_refs", "primary_outcome_ref",
        "downstream_handoff", "source_status", "source_refs"
      ],
      "properties": {
        "chain_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "chain_kind": {"enum": ["primary", "recovery", "governance"]},
        "trigger_kind": {"enum": ["business_event", "exception_or_interruption", "governance_change"]},
        "trigger_or_input": {"type": "string", "minLength": 1},
        "owned_state": {"type": "string", "minLength": 1},
        "owned_state_refs": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "object_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "operation_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "outcome_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "primary_outcome_ref": {"type": "string", "minLength": 1},
        "downstream_handoff": {"type": "string", "minLength": 1},
        "source_status": {"enum": ["user", "user-confirmed", "doc", "ai-proposed", "unresolved"]},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "evidence_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gap_id", "summary"],
      "properties": {
        "gap_id": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "business_chain_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_inventory_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "anyOf": [
        {"required": ["business_chain_refs"]},
        {"required": ["source_inventory_refs"]}
      ]
    },
    "constitution_clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clause_id", "title", "summary", "source_anchor", "applicability_status"],
      "properties": {
        "clause_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "source_anchor": {"type": "string", "minLength": 1},
        "applicability_status": {"enum": ["applicable", "possibly_applicable", "not_applicable"]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "source_type"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "source_type": {"type": "string", "minLength": 1},
        "anchors": {"type": "array", "items": {"type": "string"}}
      }
    },
    "source_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roots", "entries"],
      "properties": {
        "roots": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/source_inventory_root"}
        },
        "entries": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/source_inventory_entry"}
        }
      }
    },
    "source_inventory_root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "root_kind", "source_origin"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "root_kind": {"enum": ["directory", "file"]},
        "source_origin": {"enum": ["default-prd", "feature-prd", "parent-reference", "human-specified"]}
      }
    },
    "source_inventory_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "disposition", "rationale"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["used", "reviewed_no_capability", "duplicate", "deferred", "unreadable"]},
        "rationale": {"type": "string", "minLength": 20},
        "evidence_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/inventory_evidence_ref"}
        },
        "duplicate_of": {"type": "string", "minLength": 1},
        "evidence_gap_ref": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "used"}}},
          "then": {"required": ["evidence_refs"]},
          "else": {"not": {"required": ["evidence_refs"]}}
        },
        {
          "if": {"properties": {"disposition": {"const": "duplicate"}}},
          "then": {"required": ["duplicate_of"]}
        },
        {
          "if": {"properties": {"disposition": {"enum": ["deferred", "unreadable"]}}},
          "then": {"required": ["evidence_gap_ref"]}
        }
      ]
    },
    "inventory_evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_kind", "entity_id"],
      "properties": {
        "entity_kind": {
          "enum": [
            "responsibility_owner", "business_lifecycle", "business_state", "business_object",
            "operation", "outcome", "source_capability", "capability_atom", "business_chain",
            "outline_node"
          ]
        },
        "entity_id": {"type": "string", "minLength": 1}
      }
    },
    "question_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "map_id", "questions"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "map_id": {"type": "string", "minLength": 1},
        "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/question"}}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "outline_node_id", "target_kind", "prompt", "context", "selection_mode",
        "candidates", "recommended_candidate_ids", "recommendation_reason",
        "allow_none_of_the_above", "free_input"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "outline_node_id": {"type": "string", "minLength": 1},
        "target_kind": {"type": "string", "minLength": 1},
        "prompt": {"type": "string", "minLength": 1},
        "context": {"type": "string", "minLength": 1},
        "selection_mode": {"const": "single"},
        "candidates": {
          "type": "array", "minItems": 2, "maxItems": 4,
          "items": {"$ref": "#/$defs/candidate"}
        },
        "recommended_candidate_ids": {
          "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "recommendation_reason": {"type": "string", "minLength": 1},
        "allow_none_of_the_above": {"const": true},
        "free_input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "label", "allowed_operations"],
          "properties": {
            "enabled": {"const": true},
            "label": {"type": "string", "minLength": 1},
            "allowed_operations": {
              "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
              "items": {"enum": ["confirm_candidate", "add", "replace", "exclude", "context_note"]}
            }
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "value", "rationale", "detail", "business_chain_refs", "capability_atom_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 20},
        "business_chain_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "capability_atom_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "source_capability_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_capability_id", "label", "trigger_or_input",
        "owned_state", "observable_outcome",
        "disposition", "source_status", "source_refs"
      ],
      "properties": {
        "source_capability_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 4},
        "trigger_or_input": {"type": "string", "minLength": 8},
        "owned_state": {"type": "string", "minLength": 10},
        "observable_outcome": {"type": "string", "minLength": 10},
        "business_state_ref": {"type": "string", "minLength": 1},
        "responsibility_owner_ref": {"type": "string", "minLength": 1},
        "lifecycle_ref": {"type": "string", "minLength": 1},
        "independent_acceptance_reason": {"type": "string", "minLength": 20},
        "source_status": {"enum": ["user", "user-confirmed", "doc", "ai-proposed", "unresolved"]},
        "disposition": {
          "type": "string",
          "enum": ["atom", "evidence_gap", "excluded_by_source"]
        },
        "capability_atom_ref": {"type": "string", "minLength": 1},
        "evidence_gap_ref": {"type": "string", "minLength": 1},
        "source_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "atom"}}},
          "then": {
            "required": ["capability_atom_ref", "business_state_ref", "responsibility_owner_ref", "lifecycle_ref", "independent_acceptance_reason"],
            "not": {"required": ["evidence_gap_ref"]}
          }
        },
        {
          "if": {"properties": {"disposition": {"const": "evidence_gap"}}},
          "then": {
            "required": ["evidence_gap_ref"],
            "not": {"required": ["capability_atom_ref"]}
          }
        },
        {
          "if": {"properties": {"disposition": {"const": "excluded_by_source"}}},
          "then": {
            "not": {
              "anyOf": [
                {"required": ["capability_atom_ref"]},
                {"required": ["evidence_gap_ref"]}
              ]
            }
          }
        }
      ]
    }
  }
}
