{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speccompass.dev/schemas/outline-transition-staging-manifest.schema.json",
  "title": "SpecCompass Outline Transition Staging Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "transition_id", "transition_revision", "proposal_digest",
    "inventory_digest", "generated_at", "staging_root", "operations", "manifest_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "transition_id": {"type": "string", "minLength": 1},
    "transition_revision": {"type": "integer", "minimum": 1},
    "proposal_digest": {"$ref": "outline-boundaries.schema.json#/$defs/digest"},
    "inventory_digest": {"$ref": "outline-boundaries.schema.json#/$defs/digest"},
    "generated_at": {"type": "string", "format": "date-time"},
    "staging_root": {"$ref": "outline-boundaries.schema.json#/$defs/repoRef"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/operation"}
    },
    "manifest_digest": {"$ref": "outline-boundaries.schema.json#/$defs/digest"}
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id", "artifact_type", "source_artifact_ref", "source_digest", "source_mode",
        "operation", "target_artifact_ref", "target_feature_code",
        "staged_artifact_ref", "staged_digest"
      ],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^op-[0-9]{4}$"},
        "artifact_type": {
          "enum": ["prd", "outline", "spec", "flow", "ui", "plan", "tasks", "implementation", "test", "trace", "memory", "open_item"]
        },
        "source_artifact_ref": {"$ref": "outline-boundaries.schema.json#/$defs/repoRef"},
        "source_digest": {"$ref": "outline-boundaries.schema.json#/$defs/digest"},
        "source_mode": {"type": "integer", "minimum": 0, "maximum": 511},
        "operation": {"enum": ["move", "copy", "rewrite", "retire"]},
        "target_artifact_ref": {
          "oneOf": [{"type": "null"}, {"$ref": "outline-boundaries.schema.json#/$defs/repoRef"}]
        },
        "target_feature_code": {
          "oneOf": [{"type": "null"}, {"$ref": "outline-boundaries.schema.json#/$defs/featureCode"}]
        },
        "staged_artifact_ref": {
          "oneOf": [{"type": "null"}, {"$ref": "outline-boundaries.schema.json#/$defs/repoRef"}]
        },
        "staged_digest": {
          "oneOf": [{"type": "null"}, {"$ref": "outline-boundaries.schema.json#/$defs/digest"}]
        }
      }
    }
  }
}
